#!/bin/bash

DEFAULT_TARGET=$HOME/gallery/Photos
sumfile=$DEFAULT_TARGET/md5sum

awk '{print $1}' $sumfile | sort | uniq -c | sort -n | awk '$1!=1 {print}' | while read sumCount Sum
do
	#echo Count = $sumCount,  Sum = $Sum
  noTildaCount=$(grep $Sum $sumfile | fgrep -v \~ | wc -l)
	#echo noTildaCount = $noTildaCount
  if [[ $sumCount -gt $noTildaCount ]]
  then
    grep $Sum $sumfile | fgrep \~ | while read _sum file
    do
      echo Purging $Sum 
      echo rm \"$file\"
      rm "$file"
    done
  fi
done
