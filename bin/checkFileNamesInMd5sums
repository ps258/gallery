#!/bin/bash

# script to just check if the file name (without the extension) already exits in the md5sum file
# useful when looking at a bunch of AVIs which have to be converted to MP4 before adding.

DEFAULT_SOURCE=$HOME/gallery/photoDump
DEFAULT_TARGET=$HOME/gallery/Photos

sourceDir=${1-$DEFAULT_SOURCE}
targetDIR=${2-$DEFAULT_TARGET}
find $sourceDir -type f -not -name \*.gif -print | while read fileName
do
	basename=$(basename "$fileName")
	if grep -iwq "$basename" $targetDIR/md5sums.txt; then
		echo "[WARN]'$fileName': name exists in $targetDIR/md5sums.txt"
		ls -l $(grep -iw "$basename" $targetDIR/md5sums.txt | awk '{print $NF}' | xargs)
	fi
	sum=$(md5sum "$fileName" | awk '{print $1}')
	if grep -q $sum $targetDIR/md5sums.txt; then
		echo "[WARN]'$fileName'($sum): md5sum exists in $targetDIR/md5sums.txt"
		ls -l $(grep $sum $targetDIR/md5sums.txt | awk '{print $NF}' | xargs)
	fi
done

